<?xml version="1.0"?>
<sdf version="1.9">
  <world name="voice_nav_house_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
      <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="south"><static>true</static><pose>0 -3 0.5 0 0 0</pose><link name="south_link">
      <collision name="south_collision"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></collision>
      <visual name="south_visual"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></visual>
    </link></model>
    <model name="north"><static>true</static><pose>0 3 0.5 0 0 0</pose><link name="north_link">
      <collision name="north_collision"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></collision>
      <visual name="north_visual"><geometry><box><size>6.0 0.10 1.0</size></box></geometry></visual>
    </link></model>
    <model name="west"><static>true</static><pose>-3 0 0.5 0 0 0</pose><link name="west_link">
      <collision name="west_collision"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></collision>
      <visual name="west_visual"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></visual>
    </link></model>
    <model name="east"><static>true</static><pose>3 0 0.5 0 0 0</pose><link name="east_link">
      <collision name="east_collision"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></collision>
      <visual name="east_visual"><geometry><box><size>0.10 6.0 1.0</size></box></geometry></visual>
    </link></model>
    <model name="inner_v_lower"><static>true</static><pose>0.75 -2.25 0.5 0 0 0</pose><link name="inner_v_lower_link">
      <collision name="inner_v_lower_collision"><geometry><box><size>0.10 1.50 1.0</size></box></geometry></collision>
      <visual name="inner_v_lower_visual"><geometry><box><size>0.10 1.50 1.0</size></box></geometry></visual>
    </link></model>
    <model name="inner_v_middle"><static>true</static><pose>0.75 0.10 0.5 0 0 0</pose><link name="inner_v_middle_link">
      <collision name="inner_v_middle_collision"><geometry><box><size>0.10 1.20 1.0</size></box></geometry></collision>
      <visual name="inner_v_middle_visual"><geometry><box><size>0.10 1.20 1.0</size></box></geometry></visual>
    </link></model>
    <model name="inner_v_upper"><static>true</static><pose>0.75 2.35 0.5 0 0 0</pose><link name="inner_v_upper_link">
      <collision name="inner_v_upper_collision"><geometry><box><size>0.10 1.30 1.0</size></box></geometry></collision>
      <visual name="inner_v_upper_visual"><geometry><box><size>0.10 1.30 1.0</size></box></geometry></visual>
    </link></model>
    <model name="inner_h_west"><static>true</static><pose>-2.45 0.75 0.5 0 0 0</pose><link name="inner_h_west_link">
      <collision name="inner_h_west_collision"><geometry><box><size>1.10 0.10 1.0</size></box></geometry></collision>
      <visual name="inner_h_west_visual"><geometry><box><size>1.10 0.10 1.0</size></box></geometry></visual>
    </link></model>
    <model name="inner_h_east"><static>true</static><pose>-0.075 0.75 0.5 0 0 0</pose><link name="inner_h_east_link">
      <collision name="inner_h_east_collision"><geometry><box><size>1.65 0.10 1.0</size></box></geometry></collision>
      <visual name="inner_h_east_visual"><geometry><box><size>1.65 0.10 1.0</size></box></geometry></visual>
    </link></model>
    <model name="lower_left_box"><static>true</static><pose>-1.9 -1.6 0.4 0 0 0</pose><link name="lower_left_box_link">
      <collision name="lower_left_box_collision"><geometry><box><size>0.6 0.8 0.8</size></box></geometry></collision>
      <visual name="lower_left_box_visual"><geometry><box><size>0.6 0.8 0.8</size></box></geometry></visual>
    </link></model>
    <model name="upper_right_cylinder"><static>true</static><pose>2.0 1.9 0.4 0 0 0</pose><link name="upper_right_cylinder_link">
      <collision name="upper_right_cylinder_collision"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></collision>
      <visual name="upper_right_cylinder_visual"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></visual>
    </link></model>
  </world>
</sdf>
