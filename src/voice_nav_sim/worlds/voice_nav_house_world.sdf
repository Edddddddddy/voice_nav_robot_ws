<?xml version="1.0"?>
<sdf version="1.9">
  <world name="voice_nav_house_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></visual>
    </link></model>
    <model name="south_wall"><static>true</static><pose>0 -3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 3 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 0.1 1</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-3 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>3 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 6 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 6 1</size></box></geometry></visual></link></model>
    <model name="inner_v_lower"><static>true</static><pose>0.75 -2.25 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 1.5 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.5 1</size></box></geometry></visual></link></model>
    <model name="inner_v_middle"><static>true</static><pose>0.75 0.1 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 1.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.2 1</size></box></geometry></visual></link></model>
    <model name="inner_v_upper"><static>true</static><pose>0.75 2.35 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 1.3 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.3 1</size></box></geometry></visual></link></model>
    <model name="inner_h_west"><static>true</static><pose>-2.45 0.75 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.1 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.1 1</size></box></geometry></visual></link></model>
    <model name="inner_h_east"><static>true</static><pose>-0.075 0.75 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.65 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.65 0.1 1</size></box></geometry></visual></link></model>
    <model name="lower_left_box"><static>true</static><pose>-1.9 -1.6 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 0.8 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.8 0.8</size></box></geometry></visual></link></model>
    <model name="upper_right_cylinder"><static>true</static><pose>2 1.9 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></visual></link></model>
  </world>
</sdf>
